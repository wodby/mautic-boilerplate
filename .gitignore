# Installed by Composer and npm.
/vendor/
/node_modules/
/docroot/app/

# Plugins and themes installed by Composer. To commit a plugin or theme of your
# own, add a line for it, such as !/docroot/plugins/MyPluginBundle/
/docroot/plugins/*
/docroot/themes/*

# Copied by Mautic's Composer scaffold on every install.
/.env
/bin/
/patches/
/package.json
/package-lock.json
/webpack.config.js
/importmap.php
/tsconfig.json
/docroot/.htaccess
/docroot/index.php
/docroot/autoload.php
/docroot/robots.txt
/docroot/favicon.ico
/docroot/translations/

# Generated by Mautic's asset commands.
/docroot/assets/
/docroot/bundles/
/docroot/media/

# Written by Mautic at runtime.
/config/local.php
/var/

.idea/
.DS_Store
